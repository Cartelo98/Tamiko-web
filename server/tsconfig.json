{
    "compilerOptions": {
      "target": "ES6",
      "module": "commonjs",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "experimentalDecorators": true,  // Important pour utiliser les décorateurs
      "emitDecoratorMetadata": true    // Important pour TypeORM et les décorateurs
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
  }
  